# Target wisp instance that the Vite dev server proxies `/wisp/*` requests to.
# The dashboard always calls same-origin `/wisp/...` paths; Vite strips the
# `/wisp` prefix and forwards to this target (HTTP + WebSocket), avoiding CORS.
#
# Defaults to http://127.0.0.1:8080 when unset.
# A common alternative wisp port is http://127.0.0.1:8099
VITE_WISP_TARGET=http://127.0.0.1:8080
