# Target wisp instance that the Vite dev server proxies `/wisp/*` requests to.
# The dashboard always calls same-origin `/wisp/...` paths; Vite strips the
# `/wisp` prefix and forwards to this target (HTTP + WebSocket), avoiding CORS.
# This is the only environment variable the app reads, and it only applies to
# `npm run dev` (the proxy is a dev-server feature).
#
# Defaults to http://127.0.0.1:8080 when unset (wisp's default WISP_ADDR).
# If wisp listens elsewhere, e.g. WISP_ADDR=127.0.0.1:8099, point it there.
VITE_WISP_TARGET=http://127.0.0.1:8080
